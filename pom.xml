<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    仓库根聚合 POM。

    背景：本仓库的 Maven 多模块根目录历史上位于 server/pom.xml，
    但 CI / 验证门禁在仓库根（本文件所在目录）直接执行 `mvn test` / `mvn verify`。
    缺少根 POM 时 Maven 以 "no POM in this directory" 直接 BUILD FAILURE，
    与业务代码无关。此聚合器仅把构建委托给 server 模块，不改变任何模块依赖、
    版本或打包方式；从 server/ 目录执行原有命令的行为保持完全一致。
  -->
  <groupId>com.aps</groupId>
  <artifactId>aps-root</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>aps-root</name>
  <description>仓库根聚合器：委托构建 server 下的 Java Maven 多模块</description>

  <modules>
    <module>server</module>
  </modules>
</project>
