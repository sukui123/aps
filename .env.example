# APS 环境变量模板（技术方案 §8.6）
# 只含变量名与占位符，不含任何真实值。使用时：cp .env.example .env 后由平台/本地注入真实值。
# .env 已加入 .gitignore，禁止提交。

# PostgreSQL 连接（平台测试沙箱由运行时注入）
APS_DB_URL=jdbc:postgresql://<host>:5432/<database>
APS_DB_USER=<db-user>
APS_DB_PASSWORD=<db-password>

# JWT 签名密钥（至少 32 字符，由平台运行时注入，切勿填写真实值入库）
APS_JWT_SECRET=<generate-a-random-secret-at-least-32-chars>

# 集成凭据 AES-GCM 密钥占位（D3）；由平台运行时注入，切勿填写真实值入库。
# 未配置时集成配置写操作会 fail-fast，读/任务补偿不受影响。
APS_INTEGRATION_SECRET=<generate-a-random-secret-at-least-32-chars>

# 可选：本地文件存储目录（非敏感）
APS_STORAGE_DIR=./data/files

# 可选：裸机兜底时 docker compose 映射端口（仅本地，非生产凭据）
APS_PG_PORT=5432
