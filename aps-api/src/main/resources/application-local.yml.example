# 复制为 application-local.yml 后填写。
# application-local.yml 已被 .gitignore 忽略，不会提交。
# 绝大多数配置已在 application.yml 中通过环境变量读取，这里只需放本地覆盖项。

# 用本地 docker compose 起的 PostgreSQL 时，可这样覆盖（仅本地容器口令）：
# spring:
#   datasource:
#     url: jdbc:postgresql://localhost:5432/aps
#     username: aps
#     password: aps_local_dev_only
#     driver-class-name: org.postgresql.Driver

# 等价于设置环境变量：
# export APS_DB_URL='jdbc:postgresql://localhost:5432/aps'
# export APS_DB_USER='aps'
# export APS_DB_PASSWORD='aps_local_dev_only'
# export APS_JWT_SECRET="$(openssl rand -hex 32)"

# 启动时：java -jar aps-api/target/aps-api-0.1.0-SNAPSHOT.jar --spring.profiles.active=local
